NODE_ENV=development
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000
# Public application origin; added without replacing existing allowed origins.
APP_ORIGIN=
JWT_SECRET=
THIRDWEB_SECRET_KEY=
DEV_MONGO_URL=mongodb://127.0.0.1:27017/nexuspay_dev
PROD_MONGO_URL=
REDIS_URL=redis://127.0.0.1:6379
# 32 random bytes encoded as 64 hex characters; back up separately from MongoDB.
WALLET_KEY_ENCRYPTION_KEY=
BOTCHAIN_ENABLED=false
BOTCHAIN_TRANSFERS_ENABLED=false
BOTCHAIN_RPC_URL=https://rpc.botchain.ai
BOTCHAIN_BUNDLER_URL=https://bundler.botchain.ai/rpc
BOTCHAIN_TESTNET_ENABLED=false
BOTCHAIN_TESTNET_TRANSFERS_ENABLED=false
BOTCHAIN_TESTNET_RPC_URL=https://rpc.bohr.life
BOTCHAIN_TESTNET_BUNDLER_URL=https://bundler.bohr.life/rpc
BOTCHAIN_CONFIRMATIONS=3
RUN_PAYMENT_WORKERS=false
ENABLE_MPESA=false
MPESA_CALLBACK_SHARED_TOKEN=
MPESA_DEV_CONSUMER_KEY=
MPESA_DEV_CONSUMER_SECRET=
MPESA_DEV_SHORTCODE=
MPESA_DEV_PASSKEY=
MPESA_DEV_B2C_SHORTCODE=
MPESA_DEV_INITIATOR_NAME=
MPESA_DEV_SECURITY_CREDENTIAL=
MPESA_STK_CALLBACK_URL=
MPESA_B2C_RESULT_URL=
MPESA_B2C_TIMEOUT_URL=
MPESA_B2B_RESULT_URL=
MPESA_B2B_TIMEOUT_URL=
MPESA_PROD_CONSUMER_KEY=
MPESA_PROD_CONSUMER_SECRET=
MPESA_PROD_SHORTCODE=
MPESA_PROD_PASSKEY=
ENABLE_SMS=false
AFRICAS_TALKING_API_KEY=
AFRICAS_TALKING_USERNAME=sandbox
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
EMAIL_USER=
EMAIL_APP_PASSWORD=
RECLAIM_APP_ID=
RECLAIM_APP_SECRET=
RECLAIM_PROVIDER_IDS=
ENABLE_RECLAIM=false
COINMARKETCAP_API_KEY=
# Proxy count must match the deployed network topology.
TRUST_PROXY_HOPS=

# Base and Arbitrum users pay native ETH; optional custom bundlers must support the existing factory's EntryPoint.
BASE_RPC_URL=https://mainnet.base.org
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
# BASE_BUNDLER_URL=
# ARBITRUM_BUNDLER_URL=

# Random shared secret for the scheduled, read-only payment reconciliation endpoint.
PAYMENT_MAINTENANCE_SECRET=
