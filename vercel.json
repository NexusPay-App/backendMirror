{
  "version": 2,
  "builds": [
    {
      "src": "src/serverless.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "src/serverless.ts"
    },
    {
      "src": "/(.*)",
      "dest": "src/serverless.ts"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": true,
      "feat/modernize-botchain": true
    }
  },
  "github": {
    "autoAlias": true,
    "silent": true
  }
}
